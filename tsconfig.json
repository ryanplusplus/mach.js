{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "declarationMap": false,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "paths": {
      "machjs/*": ["./src/*"]
    }
  },
  "include": [
    "index.js",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "spec"
  ]
}
